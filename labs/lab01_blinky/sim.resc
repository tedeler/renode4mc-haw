using sysbus


# 1. C#-Modelle live in Renode kompilieren
include @../../renode_bridge/TivaGPIOPort.cs
include @../../renode_bridge/WebSocketBridge.cs

# 2. Maschine erstellen und TM4C1294-Plattform laden
mach create "tm4c1294"
machine LoadPlatformDescription @../../renode_config/platforms/tm4c1294ncpdt.repl

# 3. Log-Ausgabe für GPIO Port N im Konsolenfenster aktivieren
logLevel 1 gpioPortN

# 4. Kompilierte ELF-Datei von tiarmclang laden
sysbus LoadELF @build/blinky.elf

# 5. Simulation starten
start
