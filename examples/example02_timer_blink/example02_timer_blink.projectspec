<?xml version="1.0" encoding="UTF-8"?>
<projectSpec>
    <project
        name="example02_timer_blink"
        device="Cortex M.TM4C1294NCPDT"
        connection="Stellaris_ICDI_Connection"
        toolChain="TICLANG"
        outputFormat="ELF"
        outputType="executable"
        launchWizard="false"
        compilerBuildOptions="-mcpu=cortex-m4 -mfloat-abi=hard -mfpu=fpv4-sp-d16 -mthumb -Oz -g -ffunction-sections -fdata-sections -Wall"
        linkerBuildOptions="--rom_model --stack_size=2048 --diag_suppress=10063"
        description="example02_timer_blink (HAW microcontroller lab, EK-TM4C1294XL)">

        <!-- source code of this example -->
        <file path="main.c" openOnCreation="true" excludeFromBuild="false" action="copy"/>

        <!-- register names and bit constants from TI (copied into the project so that main.c finds them without
             an additional include path) -->
        <file path="../../common/tm4c1294ncpdt.h" openOnCreation="false" excludeFromBuild="false" action="copy"/>

        <!-- shared files: startup code (vector table), linker script -->
        <file path="../../common/startup_tm4c1294.c" targetDirectory="common" action="link"/>
        <file path="../../common/tm4c1294.cmd" targetDirectory="common" action="link"/>
    </project>
</projectSpec>
