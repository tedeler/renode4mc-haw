{
  "title": "Example 2 – EK-TM4C1294XL: Pendeldisplay, Ultraschall, UART",
  "machine": "tm4c1294",
  "uart": { "label": "UART0 (PA0 RX / PA1 TX) – 115200 8N1" },
  "ledBridge": "ws://127.0.0.1:9000",
  "leds": [
    { "id": "D1", "label": "D1 (PN1)", "color": "#22c55e", "bridge": 0 },
    { "id": "D2", "label": "D2 (PN0)", "color": "#22c55e", "bridge": 1 },
    { "id": "D3", "label": "D3 (PF4)", "color": "#22c55e", "bridge": 2 },
    { "id": "D4", "label": "D4 (PF0)", "color": "#22c55e", "bridge": 3 }
  ],
  "sensor": { "path": "sysbus.i2c0.sensor", "min": 0, "max": 400, "unit": "cm", "label": "MB1242 an I2C0, 0x70" },
  "pendulum": {
    "path": "sysbus.gpioM.pendel",
    "label": "8 LEDs an PM0–PM7 (PM0 oben an der Spitze, Drehpunkt unten), Signal an PL0: HIGH = rechts, LOW = links",
    "frequency": 10,
    "minFrequency": 0.1,
    "maxFrequency": 20
  },
  "scope": {
    "signals": [
      { "pin": "PL0", "label": "Pendel Sync (HIGH = rechts)" },
      { "pin": "PM0", "label": "Pendel-LED 0 (Spitze)" },
      { "pin": "PM1", "label": "Pendel-LED 1" },
      { "pin": "PM2", "label": "Pendel-LED 2" },
      { "pin": "PM3", "label": "Pendel-LED 3" },
      { "pin": "PM4", "label": "Pendel-LED 4" },
      { "pin": "PM5", "label": "Pendel-LED 5" },
      { "pin": "PM6", "label": "Pendel-LED 6" },
      { "pin": "PM7", "label": "Pendel-LED 7" },
      { "pin": "PN1", "label": "LED D1" },
      { "pin": "PN0", "label": "LED D2" },
      { "pin": "PF4", "label": "LED D3" },
      { "pin": "PF0", "label": "LED D4" },
      { "pin": "PJ0", "label": "USR_SW1" },
      { "pin": "PJ1", "label": "USR_SW2" },
      { "pin": "PA0", "label": "U0RX (vom Terminal)" },
      { "pin": "PA1", "label": "U0TX (zum Terminal)" }
    ],
    "channels": ["PL0", "PM0", "PM7", "PA1"],
    "trigger": { "source": "PL0", "edge": "rising" }
  }
}
