// Versuch 1 – Erweiterung der Plattform platforms/tm4c1294ncpdt.repl (wird NACH ihr geladen)
//
//   OLED SSD1306 128x64      I2C0 (PB2 SCL, PB3 SDA), Adresse 0x3C
//   Ultraschall MB1242       I2C0, Adresse 0x70
//   Keypad 4x3               Zeilen PK0..PK3 (Ausgänge), Spalten PK4..PK6 (Eingänge, Pull-down)
//   PC-Terminal             an UART0 (virtueller COM-Port), Standard 115200 8N1; in der
//                            Web-Konsole einstellbar (sysbus.uart0.host TerminalBaudRate/Format)
//   (LEDs D1..D4, Taster USR_SW1/2 und UART0 stammen aus der Basisplattform.)

host: UART.UartHostTerminal @ uart0
    baudRate: 115200
    format: "8N1"

oled: Video.SSD1306I2C @ i2c0 0x3C
    width: 128
    height: 64

sensor: Sensors.MaxBotixI2C @ i2c0 0x70

keypad: Miscellaneous.KeypadMatrix @ gpioK
    rows: 4
    columns: 3
    Col0 -> gpioK@4
    Col1 -> gpioK@5
    Col2 -> gpioK@6

gpioK:
    0 -> keypad@0
    1 -> keypad@1
    2 -> keypad@2
    3 -> keypad@3
