{
  "title": "Versuch 1 – EK-TM4C1294XL: GPIO, UART, OLED, Ultraschall, Keypad",
  "machine": "tm4c1294",
  "uart": { "label": "UART0 (PA0 RX / PA1 TX) – virtueller COM-Port", "host": "sysbus.uart0.host", "baud": 115200, "format": "8N1" },
  "signals": [
    { "name": "uart0.tx", "label": "U0TX (PA1)", "path": "sysbus.uart0" },
