      "label": "D2 (PN0)",
      "color": "#22c55e",
      "bridge": 1
    },
    {
      "id": "D3",
      "label": "D3 (PF4)",
      "color": "#22c55e",
      "bridge": 2
    },
    {
      "id": "D4",
      "label": "D4 (PF0)",
      "color": "#22c55e",
      "bridge": 3
    }
