// Lab 1 (MCL Lab Session 1) – GPIO: Hexadezimal-Keypad und 7-Segment-(BCD-)Anzeige.
// Erweiterung der Plattform platforms/tm4c1294ncpdt.repl (wird NACH ihr geladen).
//
//   Hex-Keypad 4x4 (HAW)     Spalten X1..X4 = PM0..PM3 (Ausgänge der MCU)
//                            Zeilen  Y1..Y4 = PM4..PM7 (Eingänge, Pull-up 100 kOhm auf dem Keypad)
//                            Firmware setzt nacheinander ein X auf 0 und liest Y; Anstiegszeit der
//                            Zeilen 20 us (Laufzeitverzögerung -> wait() nötig)
//   BCD-Anzeige 4 Ziffern    D0..D7 = PK0..PK7 (D0..D3 hintere, D4..D7 vordere Ziffer eines Moduls)
//                            EN rechtes Modul (Ziffern 1/0) = PL0, EN linkes Modul (Ziffern 3/2) = PL1
//                            EN = HIGH: Modul übernimmt D0..D7, EN = LOW: Modul hält den Wert
//   printf()                 CCS-Konsole (sysbus.cio)
//   (LEDs D1..D4, Taster USR_SW1/2 und UART0 stammen aus der Basisplattform.)
// Die Pins sind eine mögliche Verdrahtung wie im Laborskript ("e.g. port M") – bei anderer
// Verdrahtung nur die Zeilen unten anpassen.

hexkeypad: Miscellaneous.HexKeypad @ gpioM
    riseTimeUs: 20
    Y0 -> gpioM@4
    Y1 -> gpioM@5
    Y2 -> gpioM@6
    Y3 -> gpioM@7

gpioM:
    0 -> hexkeypad@0
    1 -> hexkeypad@1
    2 -> hexkeypad@2
    3 -> hexkeypad@3

bcd: Miscellaneous.BcdDisplay @ gpioK

gpioK:
    0 -> bcd@0
    1 -> bcd@1
    2 -> bcd@2
    3 -> bcd@3
    4 -> bcd@4
    5 -> bcd@5
    6 -> bcd@6
    7 -> bcd@7

gpioL:
    0 -> bcd@8
    1 -> bcd@9

// PC-Terminal an UART0 (virtueller COM-Port): dekodiert die Flanken der Leitung mit seiner eigenen
// Einstellung (Standard 115200 8N1, in der Web-Konsole änderbar: sysbus.uart0.host TerminalBaudRate/Format)
host: UART.UartHostTerminal @ uart0
    baudRate: 115200
    format: "8N1"

// printf() -> CCS-Konsole (Hook auf C$$IO$$ des TI-Laufzeitsystems); Adresse nur Platzhalter
cio: Miscellaneous.TiCioConsole @ sysbus <0xF0000000, +0x100>
