{
  "title": "Lab 1 – GPIO: Hex-Keypad und BCD-Anzeige (MCL Lab Session 1)",
  "machine": "tm4c1294",
  "uart": {
    "label": "UART0 (PA0 RX / PA1 TX) – Terminal 115200 8N1",
    "host": "sysbus.uart0.host",
    "baud": 115200,
    "format": "8N1"
  },
  "reset": {
    "path": "sysbus.sysctl"
  },
  "status": {
    "path": "sysbus.sysctl"
  },
  "debug": {
    "cpu": "sysbus.cpu"
  },
  "signals": [
    {
      "name": "uart0.tx",
      "label": "U0TX (PA1)",
      "path": "sysbus.uart0"
    },
    {
      "name": "uart0.rx",
      "label": "U0RX (PA0)",
      "path": "sysbus.uart0"
    }
  ],
  "ledBridge": "ws://127.0.0.1:9000",
  "leds": [
    {
      "id": "D1",
      "label": "D1 (PN1)",
      "color": "#22c55e",
      "bridge": 0
    },
    {
      "id": "D2",
      "label": "D2 (PN0)",
      "color": "#22c55e",
      "bridge": 1
    },
    {
      "id": "D3",
      "label": "D3 (PF4)",
      "color": "#22c55e",
      "bridge": 2
    },
    {
      "id": "D4",
      "label": "D4 (PF0)",
      "color": "#22c55e",
      "bridge": 3
    }
  ],
  "buttons": [
    {
      "id": "SW1",
      "label": "USR_SW1 (PJ0)",
      "port": "sysbus.gpioJ",
      "pin": 0,
      "activeLow": true
    },
    {
      "id": "SW2",
      "label": "USR_SW2 (PJ1)",
      "port": "sysbus.gpioJ",
      "pin": 1,
      "activeLow": true
    }
  ],
  "cio": {
    "path": "sysbus.cio",
    "label": "printf() wie in der CCS-Konsole (TI-Laufzeitsystem, C$$IO$$)"
  },
  "keypad": {
    "path": "sysbus.gpioM.hexkeypad",
    "title": "Hex-Keypad 4×4 (aktiv LOW)",
    "rowPins": [
      "PM4",
      "PM5",
      "PM6",
      "PM7"
    ],
    "colPins": [
      "PM0",
      "PM1",
      "PM2",
      "PM3"
    ],
    "rowNames": [
      "Y1",
      "Y2",
      "Y3",
      "Y4"
    ],
    "colNames": [
      "X1",
      "X2",
      "X3",
      "X4"
    ],
    "layout": [
      [
        "1",
        "2",
        "3",
        "F"
      ],
      [
        "4",
        "5",
        "6",
        "E"
      ],
      [
        "7",
        "8",
        "9",
        "D"
      ],
      [
        "A",
        "0",
        "B",
        "C"
      ]
    ],
    "label": "Spalten X1–X4 = PM0–PM3 (Ausgänge), Zeilen Y1–Y4 = PM4–PM7 (Eingänge mit Pull-up). Gedrückte Taste: Y = 0, wenn ihr X = 0."
  },
  "bcd": {
    "path": "sysbus.gpioK.bcd",
    "label": "D0–D7 = PK0–PK7, EN rechts (Ziffern 1/0) = PL0, EN links (Ziffern 3/2) = PL1, EN aktiv HIGH"
  },
  "solution": {
    "example": "lab01_hexkeypad_bcd",
    "label": "Musterlösung (examples/lab01_hexkeypad_bcd)"
  },
  "scope": {
