{
  "title": "Lab 1 – GPIO: Hex-Keypad und BCD-Anzeige (MCL Lab Session 1)",
  "description": "MCL Lab Session 1: Hex-Keypad an Port M, BCD-Anzeige an Port K/L, LEDs D1–D4, Taster, UART0, printf",
  "uart": {
    "baud": 115200,
    "format": "8N1",
    "label": "UART0 (PA0 RX / PA1 TX) – Terminal 115200 8N1"
  },
  "quantumUs": 10,
  "solution": {
    "example": "lab01_hexkeypad_bcd",
    "label": "Musterlösung (examples/lab01_hexkeypad_bcd)"
  },
  "elements": [
    {
      "type": "hexkeypad",
      "title": "Hex-Keypad 4×4 (aktiv LOW)",
      "label": "Spalten X1–X4 = PM0–PM3 (Ausgänge), Zeilen Y1–Y4 = PM4–PM7 (Eingänge mit Pull-up). Gedrückte Taste: Y = 0, wenn ihr X = 0.",
      "riseTimeUs": 20,
      "pins": {
        "X1": "PM0",
        "X2": "PM1",
        "X3": "PM2",
        "X4": "PM3",
        "Y1": "PM4",
        "Y2": "PM5",
        "Y3": "PM6",
        "Y4": "PM7"
      }
    },
    {
      "type": "bcd",
      "label": "D0–D7 = PK0–PK7, EN rechts (Ziffern 1/0) = PL0, EN links (Ziffern 3/2) = PL1, EN aktiv HIGH",
      "pins": {
        "D0": "PK0",
        "D1": "PK1",
        "D2": "PK2",
        "D3": "PK3",
        "D4": "PK4",
        "D5": "PK5",
        "D6": "PK6",
        "D7": "PK7",
        "EN_R": "PL0",
        "EN_L": "PL1"
      }
    },
    {
      "type": "led",
      "id": "D1",
      "label": "D1 (PN1)",
      "color": "#22c55e",
      "pin": "PN1"
    },
    {
      "type": "led",
      "id": "D2",
      "label": "D2 (PN0)",
      "color": "#22c55e",
      "pin": "PN0"
    },
    {
      "type": "led",
      "id": "D3",
      "label": "D3 (PF4)",
      "color": "#22c55e",
      "pin": "PF4"
    },
    {
      "type": "led",
      "id": "D4",
      "label": "D4 (PF0)",
      "color": "#22c55e",
      "pin": "PF0"
    },
    {
      "type": "button",
      "id": "SW1",
      "label": "USR_SW1 (PJ0)",
      "pin": "PJ0",
      "activeLow": true
    },
    {
      "type": "button",
      "id": "SW2",
      "label": "USR_SW2 (PJ1)",
      "pin": "PJ1",
      "activeLow": true
    },
    {
      "type": "cio",
      "label": "printf() wie in der CCS-Konsole (TI-Laufzeitsystem, C$$IO$$)"
    }
  ],
  "scope": {
    "channels": [
      "PM0",
      "PM4",
      "PL0",
      "PL1"
    ],
    "trigger": {
      "source": "PM0",
      "edge": "falling"
    }
  }
}
