#!/bin/bash
# ucsim - run a TM4C1294 program (.out/.elf) in the Renode simulator.
#   ucsim [--debug] [--no-browser] <program.out>
# Environment variable RENODE: path to the renode start script (default: renode from PATH
# or ~/renode/renode).
set -e
SIMDIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
DEBUG=false; BROWSER=true; ELF=""
for a in "$@"; do
  case "$a" in
    --debug) DEBUG=true ;;
    --no-browser) BROWSER=false ;;
    -h|--help) sed -n '2,5p' "$0"; exit 0 ;;
    *) ELF="$a" ;;
  esac
done
[ -f "$ELF" ] || { echo "Error: program file '$ELF' not found. Usage: ucsim [--debug] file.out" >&2; exit 1; }
ELF="$(readlink -f "$ELF")"
RENODE="${RENODE:-$(command -v renode || true)}"
[ -z "$RENODE" ] && [ -x "$HOME/renode/renode" ] && RENODE="$HOME/renode/renode"
[ -x "$RENODE" ] || { echo "Error: renode not found (see docs/INSTALL_LINUX.md, or set RENODE=...)." >&2; exit 1; }

cd "$SIMDIR"
CMD="\$elf=@$ELF; include @tm4c1294.resc"
if $DEBUG; then
  CMD="$CMD; machine StartGdbServer 3333"
  echo ">> Debug mode: GDB server on localhost:3333, the CPU waits for the debugger (no 'start')."
else
  CMD="$CMD; start"
fi
if $BROWSER; then
  (sleep 3; xdg-open "$SIMDIR/visualizer/ek-tm4c1294xl.html" >/dev/null 2>&1 || true) &
fi
echo ">> Simulator running. Quit with Ctrl+C (or 'quit' in the Renode monitor)."
# keep stdin open, otherwise Renode exits immediately
exec "$RENODE" --console -e "$CMD"
