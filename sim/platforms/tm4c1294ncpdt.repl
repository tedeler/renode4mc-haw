// Plattform: Tiva TM4C1294NCPDT (EK-TM4C1294XL), vereinfacht.
// Modelliert: Cortex-M4F + NVIC (SysTick), 1 MB Flash, 256 KB SRAM, Bit-Banding,
// SYSCTL (Clock-Gating), GPIO A-Q, Timer 0-7, UART 0-7, I2C 0-9 (Master), LED-Bridge zum Browser.
// Takt: Reset-Takt PIOSC = 16 MHz.
// nvic@N: N = IRQ-Nummer (Vektor Nr. minus 16), z. B. Timer0A = IRQ 19.

// PerformanceInMips: 11 ~ 16 MHz / 1,5 Takte pro Befehl. Damit dauert z. B. SysCtlDelay(n)
// im Simulator etwa so lange wie auf dem Board (Zeitverhalten ist nur näherungsweise gleich).
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    PerformanceInMips: 11
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0
    systickFrequency: 16000000

flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x00100000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x00040000

// Bit-Banding (TivaWare/driverlib nutzt es z. B. in SysCtlPeripheralEnable)
bbPeripherals: Miscellaneous.BitBanding @ sysbus <0x42000000, +0x2000000>
    peripheralBase: 0x40000000

bbSram: Miscellaneous.BitBanding @ sysbus <0x22000000, +0x200000>
    peripheralBase: 0x20000000

sysctl: Miscellaneous.TivaSysCtl @ sysbus 0x400FE000

// Oszilloskop der Web-Konsole (Pegel beliebiger Pins, sim/models/Oscilloscope.cs); Adresse nur Platzhalter
scope: Miscellaneous.Oscilloscope @ sysbus <0xF0001000, +0x100>

// LED-Anzeige im Browser (ws://127.0.0.1:9000): 0=D1, 1=D2, 2=D3, 3=D4
wsBridge: Miscellaneous.WebSocketBridge

gpioA: GPIOPort.TivaGPIOPort @ sysbus 0x40058000
    sysCtl: sysctl
    clockBit: 0
    portName: "A"
    IRQ -> nvic@0

gpioB: GPIOPort.TivaGPIOPort @ sysbus 0x40059000
    sysCtl: sysctl
    clockBit: 1
    portName: "B"
    IRQ -> nvic@1

gpioC: GPIOPort.TivaGPIOPort @ sysbus 0x4005A000
    sysCtl: sysctl
    clockBit: 2
    portName: "C"
    IRQ -> nvic@2

gpioD: GPIOPort.TivaGPIOPort @ sysbus 0x4005B000
    sysCtl: sysctl
    clockBit: 3
    portName: "D"
    IRQ -> nvic@3

gpioE: GPIOPort.TivaGPIOPort @ sysbus 0x4005C000
    sysCtl: sysctl
    clockBit: 4
    portName: "E"
    IRQ -> nvic@4

gpioF: GPIOPort.TivaGPIOPort @ sysbus 0x4005D000
    sysCtl: sysctl
    clockBit: 5
    portName: "F"
    IRQ -> nvic@30
    4 -> wsBridge@2
    0 -> wsBridge@3

gpioG: GPIOPort.TivaGPIOPort @ sysbus 0x4005E000
    sysCtl: sysctl
    clockBit: 6
    portName: "G"
    IRQ -> nvic@31

gpioH: GPIOPort.TivaGPIOPort @ sysbus 0x4005F000
    sysCtl: sysctl
    clockBit: 7
    portName: "H"
    IRQ -> nvic@32

gpioJ: GPIOPort.TivaGPIOPort @ sysbus 0x40060000
    sysCtl: sysctl
    clockBit: 8
    portName: "J"
    IRQ -> nvic@51

gpioK: GPIOPort.TivaGPIOPort @ sysbus 0x40061000
    sysCtl: sysctl
    clockBit: 9
    portName: "K"
    IRQ -> nvic@52

gpioL: GPIOPort.TivaGPIOPort @ sysbus 0x40062000
    sysCtl: sysctl
    clockBit: 10
    portName: "L"
    IRQ -> nvic@53

gpioM: GPIOPort.TivaGPIOPort @ sysbus 0x40063000
    sysCtl: sysctl
    clockBit: 11
    portName: "M"
    IRQ -> nvic@72

gpioN: GPIOPort.TivaGPIOPort @ sysbus 0x40064000
    sysCtl: sysctl
    clockBit: 12
    portName: "N"
    IRQ -> nvic@73
    1 -> wsBridge@0
    0 -> wsBridge@1

gpioP: GPIOPort.TivaGPIOPort @ sysbus 0x40065000
    sysCtl: sysctl
    clockBit: 13
    portName: "P"

gpioQ: GPIOPort.TivaGPIOPort @ sysbus 0x40066000
    sysCtl: sysctl
    clockBit: 14
    portName: "Q"

timer0: Timers.TivaTimer @ sysbus 0x40030000
    sysCtl: sysctl
    clockBit: 0
    IRQA -> nvic@19
    IRQB -> nvic@20

timer1: Timers.TivaTimer @ sysbus 0x40031000
    sysCtl: sysctl
    clockBit: 1
    IRQA -> nvic@21
    IRQB -> nvic@22

timer2: Timers.TivaTimer @ sysbus 0x40032000
    sysCtl: sysctl
    clockBit: 2
    IRQA -> nvic@23
    IRQB -> nvic@24

timer3: Timers.TivaTimer @ sysbus 0x40033000
    sysCtl: sysctl
    clockBit: 3
    IRQA -> nvic@35
    IRQB -> nvic@36

timer4: Timers.TivaTimer @ sysbus 0x40034000
    sysCtl: sysctl
    clockBit: 4

timer5: Timers.TivaTimer @ sysbus 0x40035000
    sysCtl: sysctl
    clockBit: 5

timer6: Timers.TivaTimer @ sysbus 0x40036000
    sysCtl: sysctl
    clockBit: 6

timer7: Timers.TivaTimer @ sysbus 0x40037000
    sysCtl: sysctl
    clockBit: 7

// UART0..7 (TivaUART). UART0 = virtueller COM-Port des Boards (PA0 RX / PA1 TX).
// Ausgabe z. B. mit:  emulation CreateServerSocketTerminal 3335 "term" false; connector Connect sysbus.uart0 term
uart0: UART.TivaUART @ sysbus 0x4000C000
    sysCtl: sysctl
    clockBit: 0
    IRQ -> nvic@5

uart1: UART.TivaUART @ sysbus 0x4000D000
    sysCtl: sysctl
    clockBit: 1
    IRQ -> nvic@6

uart2: UART.TivaUART @ sysbus 0x4000E000
    sysCtl: sysctl
    clockBit: 2
    IRQ -> nvic@33

uart3: UART.TivaUART @ sysbus 0x4000F000
    sysCtl: sysctl
    clockBit: 3
    IRQ -> nvic@56

uart4: UART.TivaUART @ sysbus 0x40010000
    sysCtl: sysctl
    clockBit: 4
    IRQ -> nvic@57

uart5: UART.TivaUART @ sysbus 0x40011000
    sysCtl: sysctl
    clockBit: 5
    IRQ -> nvic@58

uart6: UART.TivaUART @ sysbus 0x40012000
    sysCtl: sysctl
    clockBit: 6
    IRQ -> nvic@59

uart7: UART.TivaUART @ sysbus 0x40013000
    sysCtl: sysctl
    clockBit: 7
    IRQ -> nvic@60

// I2C0..9 (TivaI2C, nur Master). Geräte werden mit 7-Bit-Adresse angemeldet,
// z. B.  oled: Video.SSD1306I2C @ i2c0 0x3C   (I2C0: PB2 = SCL, PB3 = SDA)
i2c0: I2C.TivaI2C @ sysbus 0x40020000
    sysCtl: sysctl
    clockBit: 0
    IRQ -> nvic@8

i2c1: I2C.TivaI2C @ sysbus 0x40021000
    sysCtl: sysctl
    clockBit: 1
    IRQ -> nvic@37

i2c2: I2C.TivaI2C @ sysbus 0x40022000
    sysCtl: sysctl
    clockBit: 2
    IRQ -> nvic@61

i2c3: I2C.TivaI2C @ sysbus 0x40023000
    sysCtl: sysctl
    clockBit: 3
    IRQ -> nvic@62

i2c4: I2C.TivaI2C @ sysbus 0x400C0000
    sysCtl: sysctl
    clockBit: 4
    IRQ -> nvic@70

i2c5: I2C.TivaI2C @ sysbus 0x400C1000
    sysCtl: sysctl
    clockBit: 5
    IRQ -> nvic@71

i2c6: I2C.TivaI2C @ sysbus 0x400C2000
    sysCtl: sysctl
    clockBit: 6
    IRQ -> nvic@102

i2c7: I2C.TivaI2C @ sysbus 0x400C3000
    sysCtl: sysctl
    clockBit: 7
    IRQ -> nvic@103

i2c8: I2C.TivaI2C @ sysbus 0x400B8000
    sysCtl: sysctl
    clockBit: 8
    IRQ -> nvic@109

i2c9: I2C.TivaI2C @ sysbus 0x400B9000
    sysCtl: sysctl
    clockBit: 9
    IRQ -> nvic@110
